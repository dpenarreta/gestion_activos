<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitio IIS «Intranet» en SER-WEBAI (docs/despliegue-iis.md).

  IIS sirve el frontend (archivos estáticos de Vite, en C:\intranet\web) y hace
  de proxy inverso (URL Rewrite + ARR) solo para /api/ hacia Django, que escucha
  en 127.0.0.1:8010 como servicio de Windows. El resto de las direcciones son
  rutas de la aplicación de una sola página: se responden con index.html.

  /admin/ NO se reenvía a Django: es una ruta del frontend (las pantallas de la
  aplicación viven bajo /admin/...). El admin de Django queda inalcanzable desde
  la red, a propósito.

  El puerto interno (8010) tiene que coincidir con BACKEND_PORT del .env del
  servidor y con el servicio IntranetBackend.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="API hacia Django" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8010/api/{R:1}" appendQueryString="true" />
        </rule>
        <rule name="Archivos y carpetas existentes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="Rutas de la aplicación" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- El worker de pdf.js (lector de PDF) es un módulo .mjs: sin esto
           IIS responde 404. -->
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
    </staticContent>

    <security>
      <!-- removeServerHeader (IIS 10, versión 1709 en adelante; el servidor es
           Windows Server 2022): no anunciar «Microsoft-IIS/10.0» en cada
           respuesta (auditoría de seguridad, 29/10/2026). No es una defensa
           por sí misma, pero no regala la versión a quien busca fallos
           conocidos. -->
      <requestFiltering removeServerHeader="true">
        <!-- 50 MB: los adjuntos y archivos del chat son de hasta 10 MB y las
             cargas masivas de Excel pueden ser más grandes. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!-- Ni IIS ni http.sys guardan los .html en su caché (26/10/2026): las
         rutas de la aplicación (/admin/...) se responden con index.html, y la
         caché del kernel guardaba esa respuesta por dirección atada al archivo
         de la carpeta anterior, que el despliegue deja en web.anterior sin
         tocar. Esas direcciones seguían sirviendo el index.html viejo, que
         pide un JS que ya no existe: la página quedaba en blanco. -->
    <!-- 28/10/2026: no bastaba. El perfil de .html se decide por la dirección
         pedida, y /admin/institucional/organigrama no termina en .html: la
         caché del kernel seguía guardando su index.html (también tras
         reciclar el grupo de aplicaciones) y servía uno viejo. Se apaga la
         caché del kernel para todo el sitio; en la intranet no se nota. -->
    <caching enableKernelCache="false">
      <profiles>
        <add extension=".html" policy="DontCache" kernelCachePolicy="DontCache" />
      </profiles>
    </caching>

    <!-- Cabeceras de seguridad del frontend (auditoría de seguridad,
         29/10/2026). La CSP de Django (apps/core/csp.py) solo llega a /api/;
         la que protege de verdad al usuario es esta, la del SPA, porque el
         token de sesión vive en localStorage y cualquier script que llegue a
         ejecutarse en la página lo puede leer.

         Content-Security-Policy, directiva por directiva:
         - default-src 'self': lo que no se declara abajo, solo del propio sitio.
         - script-src 'self': solo los JS del sitio. Sin 'unsafe-inline' ni
           'unsafe-eval': por eso el tema inicial (tema-inicial.js) y la página
           sin conexión (sin-conexion.js) llevan su script en un archivo.
         - style-src 'self' 'unsafe-inline': React, Bootstrap, Recharts y
           html2canvas ponen estilos en atributos o en <style>; los correos que
           se previsualizan en un iframe srcdoc (que hereda esta política) traen
           estilos en línea. Un estilo inyectado no ejecuta código.
         - img-src 'self' data: blob: https:: data: para los íconos SVG de
           Bootstrap y html2canvas; blob: para las imágenes que se bajan de la
           API (noticias, aviso de inicio, adjuntos, chat); https: porque el
           logo y el favicon de Identidad visual son una URL libre y pueden
           estar en otro servidor (también las imágenes de una plantilla de
           correo en su vista previa). Para cerrarlo a 'self' hay que servir el
           logo desde el propio sitio.
         - font-src 'self': las tipografías vienen de @fontsource, empaquetadas
           en /assets/.
         - connect-src 'self': la API va por /api/v1 en el mismo origen; no hay
           WebSockets (las notificaciones y el chat consultan cada tanto).
         - media-src 'self' blob:: el video del escáner usa srcObject (no lo
           cubre la CSP); blob: es el respaldo de @zxing para navegadores viejos.
         - frame-src 'self' blob:: los visores de PDF son iframes con blob:.
           Los iframes srcdoc de la vista previa de correos no dependen de esto.
         - object-src blob:: la vista previa de la etiqueta del activo es un
           <object> con un PDF en blob:. Nada de plugins de otros orígenes.
         - worker-src 'self': el service worker (/sw.js); no hay web workers.
         - manifest-src 'self': /manifest.webmanifest.
         - base-uri 'none', form-action 'self': un <base> o un <form>
           inyectados no pueden desviar enlaces ni envíos a otro sitio.
         - frame-ancestors 'none' (y X-Frame-Options: DENY para navegadores
           viejos): nadie puede enmarcar la intranet para engañar clics.

         /api/ ya trae la suya desde Django: ver la <location path="api"> al
         final, que quita estas dos para no mandar dos políticas distintas. -->
    <httpProtocol>
      <customHeaders>
        <!-- «ASP.NET» lo agrega la configuración del servidor; no aporta nada y
             anuncia la plataforma. El «X-Powered-By: ARR/3.0» que pone ARR en
             las respuestas de /api/ no se quita aquí: la sección proxy es
             del servidor, no del sitio. Se apaga una vez, como administrador:
             appcmd.exe set config -section:system.webServer/proxy
                 -arrResponseHeader:false /commit:apphost -->
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; frame-src 'self' blob:; object-src blob:; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- /api/ lo responde Django (ARR), que ya pone su propia CSP (estricta:
       default-src 'none') y su X-Frame-Options. Si IIS agregara además las del
       sitio, la respuesta llevaría dos políticas: el navegador aplica las dos
       a la vez y, peor, una cabecera de Django cambiada por entorno
       (CONTENT_SECURITY_POLICY) quedaría tapada por la de aquí. La location va
       por la dirección pedida (/api/...), que es la que IIS usa para leer la
       configuración aunque la regla de reescritura la mande a 127.0.0.1:8010.
       (auditoría de seguridad, 29/10/2026) -->
  <location path="api">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Content-Security-Policy" />
          <remove name="X-Frame-Options" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- index.html, el service worker y el manifiesto nunca se cachean: si no,
       tras un despliegue el navegador seguiría con la versión anterior. Los
       archivos de /assets/ llevan un hash en el nombre y sí se cachean. -->
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="sw.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <!-- tema-inicial.js no lleva hash en el nombre (index.html lo pide por una
       dirección fija, antes de pintar): sin esto, un cambio tardaría en
       llegar lo que el navegador decida guardarlo. Se revalida, no se baja
       cada vez. -->
  <location path="tema-inicial.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="manifest.webmanifest">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
