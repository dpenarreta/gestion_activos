# Copie este archivo como `.env` (no se sube al repositorio) y ajuste las URL.
# Solo variables públicas: todo lo que empieza por EXPO_PUBLIC_ queda dentro
# del bundle de la app. Nunca ponga aquí contraseñas ni tokens.

# API del backend. En desarrollo, la IP del PC en la red local y el puerto del
# runserver (8010); el teléfono no entiende «localhost».
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8010/api/v1
EXPO_PUBLIC_API_URL=https://intranet.laarcourier.com/api/v1

# Web de la intranet: ahí se abren los módulos que aún no están en la app.
# EXPO_PUBLIC_URL_WEB=http://192.168.1.50:5174
EXPO_PUBLIC_URL_WEB=https://intranet.laarcourier.com

# projectId de EAS (lo da `npx eas-cli@latest init`). Sin él no hay push.
# EAS_PROJECT_ID=
