# --- Entornos y secretos ---
.env
.env.*
!.env.example
!.env.*.example

# --- Python / Django ---
__pycache__/
*.py[cod]
*.sqlite3
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
staticfiles/

# Archivos que suben los usuarios (adjuntos y evidencias, §18). Nunca se
# versionan: son facturas, actas firmadas y fotos de equipos reales, y en
# producción viven en un volumen, no en el repositorio.
media/

# --- Node / React ---
node_modules/
dist/
build/
coverage/
.vite/
npm-debug.log*

# --- Editores / SO ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Pruebas de extremo a extremo (Playwright) ---
# La sesión guardada lleva el token de una cuenta real y la contraseña cambia
# en cada ejecución: nada de esto se versiona.
frontend/e2e/.auth/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
