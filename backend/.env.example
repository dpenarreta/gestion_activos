# Copie este archivo a ".env" (dentro de backend/) y complete los valores.
# Nunca commitee ".env". Ver también el ".env.example" de la raíz del
# repositorio (variables usadas por docker-compose, no por Django
# directamente) y docs/database.md.

# --- Django ---
SECRET_KEY=<clave-segura-local>
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
SYSTEM_NAME=Gestión de Activos
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8000
# Dirección pública por la que se llega a la API (la que aparece en el esquema
# OpenAPI y en los enlaces que arma el backend). En el servidor es el origen del
# sitio IIS, no el puerto interno de Django.
PUBLIC_API_URL=http://localhost:8000

# --- Empresas ---
# El sistema trabaja con una sola empresa (docs/multiempresa.md). True vuelve
# a permitir varias: selector de empresa, alta de otras y asignación por cuenta.
MULTIEMPRESA=false

# --- SQL Server ---
DB_NAME=gestion_activos
DB_USER=gestion_activos_user
DB_PASSWORD=<password-seguro-local>
# `127.0.0.1` y no `localhost`: el motor solo publica su puerto en el loopback
# de IPv4 (ver docker-compose.yml), y en Windows `localhost` resuelve primero a
# `::1`, donde la conexión se acepta y no se entrega.
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# --- JWT ---
JWT_SECRET_KEY=<clave-segura-local>
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Minutos sin usar la sesión antes de cerrarla. Es un plazo deslizante: cada
# petición lo reinicia, así que mide inactividad, no duración. El refresh token
# de arriba sigue siendo el techo absoluto.
SESSION_IDLE_TIMEOUT_MINUTES=240
# Cada cuántos segundos se reescribe la marca de actividad. Bajarlo afina el
# corte y multiplica las escrituras; subirlo, al revés.
SESSION_ACTIVITY_WRITE_EVERY_SECONDS=60

# Clave temporal con la que nacen las cuentas creadas sin contraseña: solo
# sirve para el primer inicio de sesión, que obliga a cambiarla. Va solo en el
# .env de cada entorno (en el servidor la pone scripts/deploy/
# establecer-clave-temporal.ps1). Vacía = el alta pide escribir una.
CLAVE_INICIAL_USUARIOS=<clave-temporal-local>

# Fallos de inicio de sesión de todas las IP juntas antes de frenar el login de
# un usuario (el bloqueo por usuario e IP es LOGIN_MAX_FAILED_ATTEMPTS).
# LOGIN_MAX_FAILED_ATTEMPTS_GLOBAL=20

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Orígenes en los que Django confía para formularios con cookie (solo el admin
# de Django; la API va con token). Separados por comas y con esquema; en el
# servidor, el origen del sitio: <http(s)://servidor:puerto>.
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Proxy delante de Django ---
# Cuántos proxies de confianza hay delante (en el servidor, 1: IIS con ARR).
# Con él la IP del cliente sale de X-Forwarded-For contando desde el final, y
# no del valor que el cliente quiera escribir: la usan la auditoría, el bloqueo
# del login y el límite de peticiones. 0 = sin proxy (se usa REMOTE_ADDR). Si
# no se escribe, vale 1.
# NUM_PROXIES=1

# --- Correo (por defecto, backend de consola: nada real se envía) ---
# Para que el resumen de alertas (§19) llegue a un buzón real hay que cambiar
# el backend por SMTP y completar el servidor de salida:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.empresa.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=avisos@empresa.com
#   EMAIL_HOST_PASSWORD=<clave-del-buzon>
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL=avisos@empresa.com
# Con el backend de consola el envío se da por exitoso y el correo se imprime
# en el log del servidor: sirve para probar el contenido, no la entrega.
#
# En Laar el servidor de salida escucha en el **2524**, que no es un puerto de
# submission habitual, y anuncia STARTTLS: `EMAIL_USE_TLS=True` (no SSL, que
# cifraría desde el primer byte y ahí no hay nadie escuchando en TLS). El
# remitente debe ser un buzón que exista: uno inventado acaba en correo no
# deseado, donde un aviso no avisa a nadie. La clave se pide a Sistemas; no se
# escribe aquí ni en ningún archivo versionado.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Segundos que se espera al servidor de correo antes de dar el envío por
# fallido (20 por defecto). Sin límite, un servidor que no responde colgaba la
# tarea programada y, con ella, los respaldos.
# EMAIL_TIMEOUT=20

# Envíos de prueba del centro de alertas por hora y usuario.
ALERTAS_PRUEBA_THROTTLE_RATE=10/hour

# Renovaciones de sesión por minuto e IP. Es el otro endpoint público que
# acepta un secreto, así que lleva su propio cupo en vez de compartir el de
# anónimos con el login.
REFRESH_THROTTLE_RATE=60/min

# Zona horaria de los relojes configurables (respaldo, resumen de alertas).
TIME_ZONE=America/Guayaquil

# Carpeta del equipo donde aparecen los .bak de SQL Server (volumen de
# docker-compose.yml). Sin ella, borrar un respaldo no borra la copia de la base.
RESPALDOS_SQL_LOCAL=respaldos/sql

# --- Producción por http, sin certificado (solo en el .env del servidor) ---
# config.settings.production enciende por defecto la redirección a https y
# HSTS. Mientras el sitio no tenga certificado se apagan aquí; cómo activar
# HTTPS está en el propio production.py.
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0

# --- Base externa de SOLO LECTURA (dashboards: «Conectar vista de base de
# datos», Dashboard Directorio, rol de pagos) ---
# Sin EXTERNAL_DB_HOST la función queda deshabilitada con un error claro. El
# driver ODBC es el mismo de la base propia (DB_DRIVER). El usuario tiene que
# tener solo SELECT/EXECUTE sobre los objetos que se usan (docs/database.md).
# EXTERNAL_DB_HOST=<servidor-sql-externo>
# EXTERNAL_DB_PORT=1433
# EXTERNAL_DB_NAME=<base-externa>
# EXTERNAL_DB_USER=<usuario-solo-lectura>
# EXTERNAL_DB_PASSWORD=<password-del-usuario-solo-lectura>
# Cifrado de la conexión: «yes»/«no». TRUST_SERVER_CERTIFICATE=yes acepta un
# certificado sin validarlo; solo si el servidor no tiene uno de confianza.
# EXTERNAL_DB_ENCRYPT=yes
# EXTERNAL_DB_TRUST_SERVER_CERTIFICATE=no
# Vistas y procedimientos que se pueden consultar, separados por comas (sin
# distinguir mayúsculas; «dbo.» es opcional). Vacía = cualquier vista o
# procedimiento propio, nunca uno del sistema, y los que empiezan por «sp_»
# solo si están en la lista.
# EXTERNAL_DB_OBJETOS_PERMITIDOS=<dbo.vista_uno>,<dbo.procedimiento_dos>
# Procedimiento del rol de pagos (recibe año, mes y código de empleado).
# NOMINA_ROL_PROCEDIMIENTO=<dbo.procedimiento_rol>

# --- IA opcional (Gemini) ---
# Sin clave, la interpretación con IA responde con un error claro.
# GEMINI_API_KEY=<clave-de-gemini>
